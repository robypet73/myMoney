<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

<LinearLayout
    android:id="@+id/w_col"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/w_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="78dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="myMoney"
            android:textColor="@color/widget_sub"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/w_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Apri l'app"
        android:textColor="@color/widget_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/w_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_roi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_roi_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="@color/widget_sub"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/widget_sub"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_bm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:textColor="@color/widget_sub"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:contentDescription="Andamento del portafoglio"
        android:scaleType="fitCenter" />
    <TextView
        android:id="@+id/w_agg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/widget_sub"
        android:textSize="8sp" />
</LinearLayout>

<LinearLayout
    android:id="@+id/w_ctrl"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|end"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/w_prev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Portafoglio precedente"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="‹"
        android:textColor="@color/widget_sub"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/w_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Portafoglio successivo"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="›"
        android:textColor="@color/widget_sub"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/w_gear"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="Impostazioni del widget"
        android:padding="6dp"
        android:scaleType="fitCenter" />
</LinearLayout>
</FrameLayout>
